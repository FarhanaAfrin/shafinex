# Copy to backend/.env for local dev. On Render, set these as environment variables.

# Leave unset locally to use the bundled SQLite file (backend/local.db).
# DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/neondb?sslmode=require

# The single password used to sign in.
APP_PASSWORD=change-me

# Signs session tokens. Any long random string: `python -c "import secrets;print(secrets.token_urlsafe(48))"`
SECRET_KEY=change-me-too

TOKEN_TTL_DAYS=30
LOG_LEVEL=INFO
